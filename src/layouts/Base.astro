---
// Base layout. Every page passes through here. Add fontsource imports
// in Stage 2 once the pack's typography is chosen (self hosted, no CDN).
import '../styles/global.css';
import { canonicalUrl } from '../lib/canonicalPath';

interface Props {
  title: string;
  description: string;
  surface?: 'editorial' | 'crisis';
}

const { title, description, surface = 'editorial' } = Astro.props;
// Normalized so canonical, og:url, and anything else naming this page
// agree. build.format 'file' puts .html on Astro.url.pathname, and the
// raw value here shipped .html canonicals on every factory site while
// internal links used the extensionless form. See src/lib/canonicalPath.ts.
const canonical = canonicalUrl(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-surface={surface}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#081426" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* SVG favicon, self hosted. Without this the browser requests
        /favicon.ico on every page and logs a 404. REBRAND ME along with
        tokens.css. Before release also rasterize a 32px PNG fallback
        and a 180px apple-touch-icon FROM THE SAME SVG (render in a
        browser, sips to size) so the mark cannot drift, and keep them
        OUT of any blanket image ignore in .gitignore, which once
        silently swallowed them and shipped dead icon links that only
        CI's fresh checkout caught. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="tailscale.nixfred.com" />
    <meta property="og:image" content={new URL('/images/og-card.jpg', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/images/og-card.jpg', Astro.site)} />
    <!-- FACTORY NOTE: /images/og-card.jpg does not exist until Stage 2
         generates it (render a 1200x630 card in a browser, capture,
         sips to exact size). Until then these three tags advertise a
         missing image; generate the card before sharing any link. -->
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <slot />
  </body>
</html>
