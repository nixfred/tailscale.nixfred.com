---
// Fieldcraft index: the escalation craft guides.
import Shell from '../../layouts/Shell.astro';
import { getCollection } from 'astro:content';

const guides = (await getCollection('guides'))
  .filter((g) => g.data.track === 'fieldcraft')
  .sort((a, b) => a.data.order - b.data.order);
---

<Shell
  title="Fieldcraft · Tailscale Field Guide"
  description="Escalation engineering craft: evidence collection, reproduction construction, the handoff package, and live incident work."
>
  <main id="main">
    <header class="page-head">
      <p class="eyebrow">Craft</p>
      <h1>Fieldcraft: own the escalation.</h1>
      <p class="lede">
        The drills show investigations; these guides teach the underlying craft:
        collecting evidence that survives scrutiny, turning "sometimes at one
        site" into a reproduction anyone can run, writing the handoff package
        that needs zero follow up questions, and running a live incident without
        losing the room.
      </p>
      <div class="diagram-wrap">
<svg
        class="pipeline"
        viewBox="0 0 760 150"
        role="img"
        aria-label="The escalation pipeline: intake, evidence, reproduction, then either resolution or a handoff package to engineering"
      >
        <title>The escalation pipeline these guides cover</title>
        {[
          { x: 16, label: 'intake' },
          { x: 166, label: 'evidence' },
          { x: 316, label: 'repro' },
        ].map((s) => (
          <g>
            <rect x={s.x} y="50" width="120" height="44" rx="8" fill="var(--diagram-bg)" stroke="var(--diagram-line)" stroke-width="1.5" />
            <text x={s.x + 60} y="77" text-anchor="middle" fill="var(--diagram-text)" font-size="13" font-family="var(--font-mono)">{s.label}</text>
          </g>
        ))}
        <rect x="486" y="14" width="150" height="44" rx="8" fill="var(--diagram-bg)" stroke="var(--diagram-accent)" stroke-width="2" />
        <text x="561" y="41" text-anchor="middle" fill="var(--diagram-text)" font-size="13" font-family="var(--font-mono)">resolved</text>
        <rect x="486" y="88" width="150" height="44" rx="8" fill="var(--diagram-bg)" stroke="var(--diagram-accent)" stroke-width="2" />
        <text x="561" y="115" text-anchor="middle" fill="var(--diagram-text)" font-size="13" font-family="var(--font-mono)">handoff package</text>
        <g stroke="var(--diagram-accent)" stroke-width="2" fill="none">
          <path d="M136 72 L166 72 M286 72 L316 72" />
          <path d="M436 65 L486 40 M436 79 L486 106" />
        </g>
        <text x="660" y="41" fill="var(--diagram-text)" font-size="11" font-family="var(--font-mono)">done</text>
        <text x="650" y="115" fill="var(--diagram-text)" font-size="11" font-family="var(--font-mono)">to eng,</text>
        <text x="650" y="130" fill="var(--diagram-text)" font-size="11" font-family="var(--font-mono)">zero Qs</text>
      </svg>
</div>

      <div class="diagram-wrap">
<svg
        class="pipeline anatomy"
        viewBox="0 0 760 330"
        role="img"
        aria-label="Anatomy of a handoff package: seven fields, each one existing to prevent a specific follow up question from engineering"
      >
        <title>Seven fields, seven round trips prevented</title>
        {[
          { f: 'summary', p: 'prevents: what am I looking at?' },
          { f: 'version matrix', p: 'prevents: which build, which OS?' },
          { f: 'reproduction', p: 'prevents: can you make it happen again?' },
          { f: 'log evidence', p: 'prevents: send me the actual logs' },
          { f: 'impact scope', p: 'prevents: how urgent is this really?' },
          { f: 'ruled out list', p: 'prevents: did you check the obvious thing?' },
          { f: 'proposed owner', p: 'prevents: why is this in my queue?' },
        ].map((row, i) => {
          const y = 14 + i * 44;
          return (
            <g>
              <rect x="20" y={y} width="240" height="34" rx="6" fill="var(--diagram-bg)" stroke="var(--diagram-accent)" stroke-width="1.5" />
              <text x="36" y={y + 22} font-size="13" font-family="var(--font-mono)" fill="var(--diagram-accent)">{row.f}</text>
              <line x1="260" y1={y + 17} x2="300" y2={y + 17} stroke="var(--diagram-line)" stroke-width="1.5" />
              <text x="312" y={y + 22} font-size="12" font-family="var(--font-mono)" fill="var(--diagram-text)">{row.p}</text>
            </g>
          );
        })}
        <text x="20" y="322" font-size="11" font-family="var(--font-mono)" fill="var(--diagram-text)" opacity="0.7">a missing field is not a formatting problem, it is a day of latency</text>
      </svg>
</div>
    </header>

    <ol class="guide-list">
      {guides.map((g) => (
        <li>
          <a class="row" href={`/fieldcraft/${g.data.slug}`}>
            <span class="mono num">{String(g.data.order).padStart(2, '0')}</span>
            <span class="body">
              <span class="title">{g.data.title}</span>
              <span class="desc">{g.data.description}</span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </main>
</Shell>

<style>
  main {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 var(--space-4);
  }

  .page-head {
    padding: var(--space-6) 0 var(--space-4);
  }

  h1 {
    font-size: var(--text-3xl);
  }

  .lede {
    font-size: var(--text-lg);
    color: var(--text-muted);
    max-width: 60ch;
  }

  .anatomy {
    margin-top: var(--space-3);
  }

  .pipeline {
    width: 100%;
    max-width: 800px;
    margin-top: var(--space-4);
    background: var(--diagram-bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-3);
  }

  .guide-list {
    list-style: none;
    margin: var(--space-4) 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .row {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--text);
    background: var(--card-bg);
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .row:hover {
    border-color: var(--accent);
  }

  .num {
    color: var(--accent);
    font-size: var(--text-sm);
    flex-shrink: 0;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .title {
    font-family: var(--font-display);
    font-weight: 700;
  }

  .desc {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
</style>
