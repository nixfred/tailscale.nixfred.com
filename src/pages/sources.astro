---
// The sources ledger. Aggregates every source cited by every module,
// with the date each was last checked. This page is the receipt trail
// for the whole site (LAWS 9, STANDARDS 2).
import Shell from '../layouts/Shell.astro';
import { getCollection } from 'astro:content';

const modules = (await getCollection('modules')).sort(
  (a, b) => a.data.order - b.data.order
);
const drills = await getCollection('drills');
const guides = await getCollection('guides');
const recipes = await getCollection('recipes');
const labs = await getCollection('labs');

type Row = {
  url: string;
  title: string;
  checked: string;
  usedBy: string[];
};

const byUrl = new Map<string, Row>();
function add(label: string, sources: { url: string; title: string; checked: string }[]) {
  for (const s of sources) {
    const row = byUrl.get(s.url);
    if (row) {
      row.usedBy.push(label);
      if (s.checked > row.checked) row.checked = s.checked;
    } else {
      byUrl.set(s.url, { url: s.url, title: s.title, checked: s.checked, usedBy: [label] });
    }
  }
}
for (const m of modules) add(`${String(m.data.module).padStart(2, '0')} ${m.data.title}`, m.data.sources);
for (const d of drills) add(`drill: ${d.data.slug}`, d.data.sources);
for (const g of guides) add(`${g.data.track === 'fieldcraft' ? 'craft' : 'lab'}: ${g.data.slug}`, g.data.sources);
for (const r of recipes) add(`recipe: ${r.data.slug}`, r.data.sources);
for (const l of labs) add(`lab: ${l.data.slug}`, l.data.sources);
const rows = [...byUrl.values()].sort((a, b) => a.title.localeCompare(b.title));

// Citation load per track, counted from the ledger itself.
const trackCounts = [
  { label: 'curriculum', n: rows.filter((r) => r.usedBy.some((u) => /^\d\d /.test(u))).length },
  { label: 'drills', n: rows.filter((r) => r.usedBy.some((u) => u.startsWith('drill:'))).length },
  { label: 'fieldcraft', n: rows.filter((r) => r.usedBy.some((u) => u.startsWith('craft:'))).length },
  { label: 'code lab', n: rows.filter((r) => r.usedBy.some((u) => u.startsWith('lab:'))).length },
  { label: 'recipes', n: rows.filter((r) => r.usedBy.some((u) => u.startsWith('recipe:'))).length },
  { label: 'labs', n: rows.filter((r) => r.usedBy.some((u) => u.startsWith('lab:'))).length },
];
const maxTrack = Math.max(1, ...trackCounts.map((t) => t.n));
const shared = rows.filter((r) => r.usedBy.length > 1).length;
---

<Shell
  title="Sources ledger · Tailscale Field Guide"
  description="Every source this site cites, with the date each was last checked against official documentation."
>
  <main id="main">
    <header class="page-head">
      <p class="eyebrow">Receipts</p>
      <h1>The sources ledger.</h1>
      <p class="lede">
        Every factual product claim on this site resolves to an entry here. The
        hierarchy: official documentation first, then the knowledge base, the
        changelog, the official blog, and the open source code itself. Third
        party writeups are leads for investigation, never citations. When
        official pages conflict, the narrowest current claim wins and the
        resolution is noted on this page.
      </p>
      <div class="diagram-wrap">
<svg
        class="hierarchy"
        viewBox="0 0 680 250"
        role="img"
        aria-label="The source hierarchy: official documentation at the top, then knowledge base, changelog, blog, and source code; third party writeups sit outside as leads only"
      >
        <title>What counts as a citation here</title>
        <g>
          {[
            { y: 16, w: 380, label: '1 docs', note: 'tailscale.com/docs' },
            { y: 62, w: 340, label: '2 KB', note: 'knowledge base' },
            { y: 108, w: 300, label: '3 changelog', note: 'what shipped, when' },
            { y: 154, w: 260, label: '4 blog', note: 'official engineering posts' },
            { y: 200, w: 220, label: '5 code', note: 'github.com/tailscale' },
          ].map((r) => (
            <g>
              <rect x="16" y={r.y} width={r.w} height="34" rx="6" fill="var(--diagram-bg)" stroke="var(--diagram-accent)" stroke-width="1.5" />
              <text x="30" y={r.y + 22} fill="var(--diagram-text)" font-size="13" font-family="var(--font-mono)">{r.label}</text>
              <text x={r.w - 132} y={r.y + 22} fill="var(--diagram-text)" font-size="11" font-family="var(--font-mono)" opacity="0.7">{r.note}</text>
            </g>
          ))}
        </g>
        <rect x="452" y="86" width="212" height="86" rx="8" fill="var(--diagram-bg)" stroke="var(--diagram-line)" stroke-width="1.5" stroke-dasharray="6 6" />
        <text x="468" y="116" fill="var(--diagram-text)" font-size="12" font-family="var(--font-mono)">third party writeups:</text>
        <text x="468" y="136" fill="var(--diagram-accent)" font-size="12" font-family="var(--font-mono)">leads to investigate,</text>
        <text x="468" y="156" fill="var(--diagram-accent)" font-size="12" font-family="var(--font-mono)">never citations</text>
      </svg>
</div>

      <div class="diagram-wrap">
<svg
        class="hierarchy load"
        viewBox="0 0 680 210"
        role="img"
        aria-label={`Citation load by track: ${trackCounts.map((t) => `${t.label} ${t.n}`).join(', ')}. ${shared} sources are cited by more than one page.`}
      >
        <title>How the ledger is distributed across the tracks</title>
        {trackCounts.map((t, i) => {
          const y = 18 + i * 40;
          const w = Math.max(4, Math.round((t.n / maxTrack) * 420));
          return (
            <g>
              <text x="16" y={y + 20} font-size="12" font-family="var(--font-mono)" fill="var(--diagram-text)">{t.label}</text>
              <rect x="120" y={y + 6} width={w} height="18" rx="4" fill="var(--diagram-accent)" opacity="0.85" />
              <text x={120 + w + 10} y={y + 20} font-size="12" font-family="var(--font-mono)" fill="var(--diagram-text)">{t.n}</text>
            </g>
          );
        })}
        <text x="16" y="192" font-size="11" font-family="var(--font-mono)" fill="var(--diagram-text)" opacity="0.75">
          {`${rows.length} distinct sources, ${shared} of them cited by more than one page`}
        </text>
      </svg>
</div>
    </header>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Source</th>
            <th>Checked</th>
            <th>Cited by</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <td><a href={r.url}>{r.title}</a></td>
              <td class="mono">{r.checked}</td>
              <td class="mono used">{r.usedBy.join(', ')}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="count mono">{rows.length} sources on ledger.</p>
  </main>
</Shell>

<style>
  main {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 var(--space-4);
  }

  .page-head {
    padding: var(--space-6) 0 var(--space-4);
  }

  h1 {
    font-size: var(--text-3xl);
  }

  .lede {
    font-size: var(--text-lg);
    color: var(--text-muted);
    max-width: 62ch;
  }

  .load {
    margin-top: var(--space-3);
  }

  .hierarchy {
    width: 100%;
    max-width: 720px;
    margin: var(--space-4) 0;
    background: var(--diagram-bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-3);
  }

  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  th,
  td {
    text-align: left;
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }

  th {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-faint);
  }

  .used {
    color: var(--text-faint);
    font-size: var(--text-xs);
  }

  .count {
    margin-top: var(--space-3);
    color: var(--text-faint);
    font-size: var(--text-sm);
  }
</style>
