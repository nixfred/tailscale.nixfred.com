---
// One code lab guide.
import Shell from '../../layouts/Shell.astro';
import { getCollection, render } from 'astro:content';
import TrackRail from '../../components/TrackRail.astro';

export async function getStaticPaths() {
  const guides = (await getCollection('guides')).filter(
    (g) => g.data.track === 'code-lab'
  );
  return guides.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const track = (await getCollection('guides'))
  .filter((g) => g.data.track === 'code-lab')
  .map((g) => ({ slug: g.data.slug, title: g.data.title, order: g.data.order }));
const minutes = entry.data.words
  ? Math.max(1, Math.round(entry.data.words / 230))
  : null;
---

<Shell title={`${entry.data.title} · Code lab · Tailscale Field Guide`} description={entry.data.description}>
  <main id="main">
    <header class="guide-head">
      <p class="eyebrow mono">Code lab {String(entry.data.order).padStart(2, '0')}{minutes ? ` · ${minutes} min` : ''}</p>
      <h1>{entry.data.title}</h1>
      <p class="lede">{entry.data.description}</p>
    </header>

    <TrackRail guides={track} current={entry.data.slug} label="code lab" />

    <article class="prose">
      <Content />
    </article>

    <section class="sources" aria-label="Sources">
      <h2>Sources</h2>
      <ol>
        {entry.data.sources.map((s) => (
          <li>
            <a href={s.url}>{s.title}</a>
            <span class="mono checked">checked {s.checked}</span>
          </li>
        ))}
      </ol>
    </section>

    <p class="back"><a href="/code-lab">All code lab guides</a></p>
  </main>
</Shell>

<style>
  main {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 var(--space-4);
  }

  .guide-head {
    padding: var(--space-6) 0 var(--space-4);
    border-bottom: 1px solid var(--line);
    margin-bottom: var(--space-5);
  }

  h1 {
    font-size: var(--text-3xl);
    max-width: 24ch;
  }

  .lede {
    font-size: var(--text-lg);
    color: var(--text-muted);
    max-width: 58ch;
  }

  .sources {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }

  .sources h2 {
    font-size: var(--text-xl);
  }

  .checked {
    color: var(--text-faint);
    font-size: var(--text-xs);
    margin-left: var(--space-2);
  }

  .back {
    margin: var(--space-5) 0;
  }
</style>
