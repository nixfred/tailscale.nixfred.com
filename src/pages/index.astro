---
// Homepage. Real content only: what exists is linked, what is coming
// is described as authored roadmap prose with no links (Law 12).
import Shell from '../layouts/Shell.astro';
import { getCollection } from 'astro:content';

const modules = (await getCollection('modules')).sort(
  (a, b) => a.data.order - b.data.order
);
const totalWords = modules.reduce((n, m) => n + (m.data.words ?? 0), 0);
---

<Shell
  title="Tailscale Field Guide"
  description="An unofficial Tailscale field guide and lab notebook: how the mesh actually works, feature by feature, packet by packet."
  surface="crisis"
>
  <main id="main">
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">Unofficial field guide and lab notebook</p>
        <h1>How Tailscale actually works.</h1>
        <p class="lede">
          Mechanism first, marketing never. This site explains the mesh from the
          WireGuard handshake up: the control plane, NAT traversal, DERP, MagicDNS,
          ACLs, and what every CLI command really tells you. Every factual claim
          traces to an official source with a checked date, and the lab material is
          tested on a real tailnet before it is published.
        </p>
        <p class="mono status">
          {modules.length} modules live · {totalWords.toLocaleString('en-US')} words · every claim sourced
        </p>
        <div class="subject">
          <img
            src="/brand/tailscale-logo-white.svg"
            alt="Tailscale wordmark"
            width="746"
            height="144"
            loading="eager"
          />
          <p class="subject-note">
            The subject of this guide. The Tailscale name and logo belong to
            Tailscale Inc.; this independent site uses them only to identify the
            product it documents.
          </p>
        </div>
      </div>
      <svg
        class="hero-mesh"
        viewBox="0 0 420 420"
        role="img"
        aria-label="A five node mesh: four devices with direct encrypted paths between them, and a dashed fallback path through a relay"
      >
        <title>The shape of a tailnet: direct paths first, relay as fallback</title>
        <g stroke="var(--diagram-line)" stroke-width="1.5" fill="none">
          <path d="M210 60 L60 210 M210 60 L360 210 M60 210 L210 360 M360 210 L210 360 M60 210 L360 210" />
        </g>
        <g stroke="var(--diagram-accent)" stroke-width="2.5" fill="none">
          <path d="M210 60 L210 360" />
        </g>
        <g stroke="var(--diagram-line)" stroke-width="2" stroke-dasharray="6 6" fill="none">
          <path d="M210 60 L318 108 M318 108 L360 210" />
        </g>
        <rect x="296" y="86" width="44" height="44" rx="8" fill="var(--diagram-bg)" stroke="var(--diagram-line)" stroke-width="1.5" />
        <text x="318" y="113" text-anchor="middle" fill="var(--diagram-text)" font-size="12" font-family="var(--font-mono)">DERP</text>
        <g>
          <circle cx="210" cy="60" r="26" fill="var(--diagram-bg)" stroke="var(--diagram-accent)" stroke-width="2" />
          <circle cx="60" cy="210" r="26" fill="var(--diagram-bg)" stroke="var(--diagram-line)" stroke-width="2" />
          <circle cx="360" cy="210" r="26" fill="var(--diagram-bg)" stroke="var(--diagram-line)" stroke-width="2" />
          <circle cx="210" cy="360" r="26" fill="var(--diagram-bg)" stroke="var(--diagram-accent)" stroke-width="2" />
        </g>
        <g fill="var(--diagram-text)" font-size="13" text-anchor="middle" font-family="var(--font-mono)">
          <text x="210" y="65">node-a</text>
          <text x="60" y="215">phone</text>
          <text x="360" y="215">cloud-1</text>
          <text x="210" y="365">node-b</text>
        </g>
        <text x="222" y="216" fill="var(--diagram-accent)" font-size="12" font-family="var(--font-mono)">direct</text>
      </svg>
    </section>

    <section class="band">
      <h2>The curriculum</h2>
      <p>
        Numbered modules, meant to be read in order. Each one explains its layer
        three ways (an analogy, the mechanism, the failure modes), shows what the
        layer looks like on the wire, and ends with scenario questions that have
        real answers.
      </p>
      <div class="cards">
        {modules.map((m) => (
          <a class="card" href={`/learn/${m.data.slug}`}>
            <span class="mono num">{String(m.data.module).padStart(2, '0')}</span>
            <span class="card-title">{m.data.title}</span>
            <span class="card-desc">{m.data.description}</span>
            <span class="mono card-meta">
              {m.data.words ? `${Math.max(1, Math.round((m.data.words ?? 0) / 230))} min read` : 'reference'}
            </span>
          </a>
        ))}
      </div>
      <p><a href="/learn">Full curriculum index, including what is still in the workshop.</a></p>
    </section>

    <section class="band">
      <h2>What this site will grow into</h2>
      <p>
        Four tracks, publishing in deliberate order. Nothing here links until it
        exists, and nothing ships as a stub.
      </p>
      <ol class="tracks">
        <li>
          <strong>Curriculum.</strong> The internals, live now above: orientation,
          WireGuard, the control plane, NAT traversal, troubleshooting. Identity,
          ACLs, DNS, routing, Serve and Funnel, the platform matrix, enterprise
          operations, and a codebase tour follow in numbered order.
        </li>
        <li>
          <strong>Feature encyclopedia.</strong> One reference page per feature and
          a complete CLI tour, for the reader with 30 seconds and a specific
          question.
        </li>
        <li>
          <strong>Fieldcraft and drills.</strong> Evidence collection, reproduction
          construction, engineering handoff packages, and written case study
          drills: symptom, evidence, hypothesis tree, root cause.
        </li>
        <li>
          <strong>Code lab.</strong> Guided reads of the open source Go codebase,
          pprof exercises, and annotated packet captures.
        </li>
      </ol>
    </section>

    <section class="band">
      <h2>How to read this site</h2>
      <p>
        Modules use five recurring callouts. They mark the paragraphs worth
        slowing down for:
      </p>
      <aside class="callout callout-how" data-label="How it works">
        <p>The mechanism under the surface, in enough depth to whiteboard it.</p>
      </aside>
      <aside class="callout callout-gotcha" data-label="Gotcha">
        <p>Sharp edges, version quirks, and the mistakes everyone makes once.</p>
      </aside>
      <aside class="callout callout-wire" data-label="On the wire">
        <p>What this looks like in packets, logs, and CLI output.</p>
      </aside>
      <aside class="callout callout-field" data-label="From the field">
        <p>Operational judgment: when to use what, and when not to.</p>
      </aside>
      <aside class="callout callout-lab" data-label="Lab">
        <p>Try it now, with exact commands and expected output.</p>
      </aside>
      <p>
        Claims carry receipts. The <a href="/sources">sources ledger</a> lists
        every reference with the date it was last checked against the official
        documentation.
      </p>
    </section>
  </main>
</Shell>

<style>
  main {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 var(--space-4);
  }

  .hero {
    padding: var(--space-7) 0 var(--space-6);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    align-items: center;
  }

  @media (min-width: 960px) {
    .hero {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    }
  }

  .hero-mesh {
    width: 100%;
    max-width: 420px;
    justify-self: center;
  }

  .subject {
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }

  .subject img {
    width: 100%;
    max-width: 300px;
    height: auto;
    opacity: 0.92;
  }

  .subject-note {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-faint);
    max-width: 48ch;
  }

  h1 {
    font-size: var(--text-hero);
    max-width: 16ch;
  }

  .lede {
    font-size: var(--text-lg);
    color: var(--text-muted);
    max-width: 58ch;
  }

  .status {
    font-size: var(--text-sm);
    color: var(--accent);
    letter-spacing: 0.06em;
  }

  .band {
    padding: var(--space-6) 0 0;
  }

  .band h2 {
    font-size: var(--text-2xl);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-3);
    margin: var(--space-4) 0;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    background: var(--card-bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    text-decoration: none;
    color: var(--text);
    transition: border-color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }

  .card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .num {
    color: var(--accent);
    font-size: var(--text-sm);
  }

  .card-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-lg);
    line-height: 1.2;
  }

  .card-desc {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .card-meta {
    color: var(--text-faint);
    font-size: var(--text-xs);
    margin-top: auto;
  }

  .tracks li {
    margin-bottom: var(--space-3);
    max-width: var(--measure);
  }
</style>
