---
// Curriculum index. Live modules come from the content collection.
// Planned modules render as authored prose with NO links (Law 12: no
// placeholders, no dead links; the link gate enforces the contract).
import Shell from '../../layouts/Shell.astro';
import { getCollection } from 'astro:content';

const modules = (await getCollection('modules')).sort(
  (a, b) => a.data.order - b.data.order
);
const liveNumbers = new Set(modules.map((m) => m.data.module));

const planned = [
  { n: 4, title: 'Identity and auth', note: 'SSO, auth keys, tags, device identity, workload identity federation.' },
  { n: 5, title: 'Policy: ACLs and grants', note: 'The tailnet policy file, grants, autogroups, posture, and the classic lockout traps.' },
  { n: 6, title: 'DNS: MagicDNS and split DNS', note: 'The resolution chain end to end, per OS behavior, and the failure catalog.' },
  { n: 7, title: 'Routing', note: 'Subnet routers, exit nodes, site to site, 4via6, app connectors, route conflicts.' },
  { n: 8, title: 'Exposing services', note: 'Serve, Funnel, HTTPS certificates, Tailscale Services, tsnet.' },
  { n: 9, title: 'The platform matrix', note: 'Linux, macOS, Windows, mobile, headless, containers, the Kubernetes operator.' },
  { n: 10, title: 'Enterprise operations', note: 'Logging and audit, SCIM, Tailnet Lock, device approval, operating at scale.' },
  { n: 12, title: 'The codebase', note: 'A guided tour of the open source repo: wgengine, magicsock, ipnlocal, derp, tsnet.' },
].filter((p) => !liveNumbers.has(p.n));
---

<Shell
  title="Learn Tailscale: the curriculum"
  description="Numbered modules that explain Tailscale from the WireGuard handshake up: mechanism, wire format, failure modes."
>
  <main id="main">
    <header class="page-head">
      <p class="eyebrow">Curriculum</p>
      <h1>Read the mesh in order.</h1>
      <p class="lede">
        Each module explains one layer three ways: an analogy, the mechanism,
        and the failure modes. Then it shows the layer on the wire and ends with
        scenario questions that have real answers. Modules publish in numbered
        order; the list below shows exactly what exists today.
      </p>
      <div class="diagram-wrap">
<svg
        class="map"
        viewBox="0 0 760 250"
        role="img"
        aria-label="The curriculum map: a data plane row, a control plane row, and an operate row, each holding four numbered modules"
      >
        <title>Three planes, thirteen modules</title>
        <g fill="var(--diagram-text)" font-size="12" font-family="var(--font-mono)">
          <text x="8" y="46">data</text>
          <text x="8" y="126">control</text>
          <text x="8" y="206">operate</text>
        </g>
        <g>
          {[
            { x: 90, y: 20, n: '01', t: 'WireGuard', row: 0 },
            { x: 258, y: 20, n: '03', t: 'NAT traversal', row: 0 },
            { x: 426, y: 20, n: '07', t: 'Routing', row: 0 },
            { x: 594, y: 20, n: '08', t: 'Services', row: 0 },
            { x: 90, y: 100, n: '02', t: 'Control plane', row: 1 },
            { x: 258, y: 100, n: '04', t: 'Identity', row: 1 },
            { x: 426, y: 100, n: '05', t: 'Policy', row: 1 },
            { x: 594, y: 100, n: '06', t: 'DNS', row: 1 },
            { x: 90, y: 180, n: '09', t: 'Platforms', row: 2 },
            { x: 258, y: 180, n: '10', t: 'Operations', row: 2 },
            { x: 426, y: 180, n: '11', t: 'Troubleshoot', row: 2 },
            { x: 594, y: 180, n: '12', t: 'Codebase', row: 2 },
          ].map((b) => (
            <g>
              <rect x={b.x} y={b.y} width="150" height="44" rx="8" fill="var(--diagram-bg)" stroke="var(--diagram-line)" stroke-width="1.5" />
              <text x={b.x + 12} y={b.y + 27} fill="var(--diagram-accent)" font-size="13" font-family="var(--font-mono)">{b.n}</text>
              <text x={b.x + 44} y={b.y + 27} fill="var(--diagram-text)" font-size="13" font-family="var(--font-mono)">{b.t}</text>
            </g>
          ))}
        </g>
        <g stroke="var(--diagram-line)" stroke-width="1.5" fill="none">
          <path d="M240 42 L258 42 M408 42 L426 42 M576 42 L594 42" />
          <path d="M240 122 L258 122 M408 122 L426 122 M576 122 L594 122" />
          <path d="M240 202 L258 202 M408 202 L426 202 M576 202 L594 202" />
        </g>
        <text x="90" y="248" fill="var(--diagram-text)" font-size="12" font-family="var(--font-mono)">00 orientation opens the map. Read the rows left to right.</text>
      </svg>
</div>

      <div class="diagram-wrap">
<svg
        class="map paths"
        viewBox="0 0 760 250"
        role="img"
        aria-label="Three ways to read the curriculum: straight through in order, symptom first starting at troubleshooting, or feature first jumping to the owning module"
      >
        <title>Three reading paths through the same thirteen modules</title>
        {[
          {
            y: 16,
            name: 'straight through',
            when: 'you want the whole system',
            route: '00 to 12 in order',
          },
          {
            y: 92,
            name: 'symptom first',
            when: 'something is broken now',
            route: '11 troubleshooting, then 03, 06, or 07',
          },
          {
            y: 168,
            name: 'feature first',
            when: 'you need one answer',
            route: 'jump to the module that owns the feature',
          },
        ].map((p, i) => (
          <g>
            <rect x="20" y={p.y} width="200" height="60" rx="8" fill="var(--diagram-bg)" stroke="var(--diagram-accent)" stroke-width="1.5" />
            <text x="36" y={p.y + 26} font-size="13" font-family="var(--font-mono)" fill="var(--diagram-accent)">{p.name}</text>
            <text x="36" y={p.y + 46} font-size="11" font-family="var(--font-mono)" fill="var(--diagram-text)" opacity="0.8">{p.when}</text>
            <line x1="220" y1={p.y + 30} x2="270" y2={p.y + 30} stroke="var(--diagram-line)" stroke-width="1.5" />
            <rect x="270" y={p.y} width="470" height="60" rx="8" fill="var(--diagram-bg)" stroke="var(--diagram-line)" stroke-width="1.5" />
            <text x="288" y={p.y + 36} font-size="13" font-family="var(--font-mono)" fill="var(--diagram-text)">{p.route}</text>
          </g>
        ))}
        <text x="20" y="242" font-size="11" font-family="var(--font-mono)" fill="var(--diagram-text)" opacity="0.7">every module cross references the others, so no path is a dead end</text>
      </svg>
</div>
    </header>

    <section aria-label="Live modules">
      <h2>Live now</h2>
      <ol class="module-list">
        {modules.map((m) => (
          <li>
            <a class="row" href={`/learn/${m.data.slug}`}>
              <span class="mono num">{String(m.data.module).padStart(2, '0')}</span>
              <span class="body">
                <span class="title">{m.data.title}</span>
                <span class="desc">{m.data.description}</span>
              </span>
              <span class="mono meta">
                {m.data.words ? `${Math.max(1, Math.round((m.data.words ?? 0) / 230))} min` : ''}
              </span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    {planned.length > 0 && (
      <section aria-label="In the workshop">
        <h2>In the workshop</h2>
        <p>
          Written next, in this order. These are titles and scope, not links:
          a module appears above only when it is real.
        </p>
        <ol class="planned">
          {planned.map((p) => (
            <li>
              <span class="mono num">{String(p.n).padStart(2, '0')}</span>
              <span class="body">
                <span class="title">{p.title}</span>
                <span class="desc">{p.note}</span>
              </span>
            </li>
          ))}
        </ol>
      </section>
    )}
  </main>
</Shell>

<style>
  main {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 var(--space-4);
  }

  .page-head {
    padding: var(--space-6) 0 var(--space-4);
  }

  h1 {
    font-size: var(--text-3xl);
  }

  .lede {
    font-size: var(--text-lg);
    color: var(--text-muted);
    max-width: 58ch;
  }

  .paths {
    margin-top: var(--space-3);
  }

  .map {
    width: 100%;
    max-width: 800px;
    margin-top: var(--space-4);
    background: var(--diagram-bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-3);
  }

  h2 {
    font-size: var(--text-xl);
    margin-top: var(--space-5);
  }

  .module-list,
  .planned {
    list-style: none;
    margin: var(--space-4) 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .row,
  .planned li {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--text);
  }

  .row {
    background: var(--card-bg);
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .row:hover {
    border-color: var(--accent);
  }

  .planned li {
    opacity: 0.75;
  }

  .num {
    color: var(--accent);
    font-size: var(--text-sm);
    flex-shrink: 0;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .title {
    font-family: var(--font-display);
    font-weight: 700;
  }

  .desc {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .meta {
    margin-left: auto;
    color: var(--text-faint);
    font-size: var(--text-xs);
    flex-shrink: 0;
  }
</style>
